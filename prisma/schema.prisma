generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Score {
  id            String    @id @default(cuid())
  playerName    String    @db.VarChar(20)
  playerNameKey String    @unique @db.VarChar(20)
  character     String
  mode          String
  score         Int       @default(0)
  timeMs        Int
  databrusCount Int
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([mode, score(sort: Desc)])
}
